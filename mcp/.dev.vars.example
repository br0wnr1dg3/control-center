SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
OWNER_PASSPHRASE=<long random passphrase>
PUBLIC_URL=http://localhost:8787
UPLOAD_TOKEN=local-upload-token

# Inbound events, one secret per team: INBOUND_SECRET_<TEAM KEY>. The smoke test uses these two.
INBOUND_SECRET_SMOKE_CO=local-inbound-secret
INBOUND_SECRET_SMOKE_OTHER=local-inbound-secret

# Outbound webhooks: retry at once instead of after 60s, 120s, ... so the smoke test needn't wait.
WEBHOOK_RETRY_BASE_SECONDS=0

# Email capture (optional)
AGENTMAIL_INBOX=you@agentmail.to
ALLOWED_SENDERS=you@example.com
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
